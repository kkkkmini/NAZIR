# Copy to .env.local for local development. Never commit real keys.
# Rules are enforced at server startup (src/server/config/runtime-config.ts).

# local | test | staging | production. Missing or unknown => production (fail-closed).
NAZIR_RUNTIME_ENV=local

# mock | toss   (mock allowed only in local/test)
PAYMENT_PROVIDER=mock
# mock | nice   (mock allowed only in local/test)
IDENTITY_PROVIDER=mock

# Toss Payments — API individual integration keys only (test_ck_/test_sk_; live_ only in production)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_SECURITY_KEY=

# NICE ID — issued after outbound IP registration
NICE_CLIENT_ID=
NICE_CLIENT_SECRET=
# Comma-separated client ids this environment may use (required in production)
NICE_ALLOWED_CLIENT_IDS=

# ── Database (Step 2) ─────────────────────────────────────────────────────────
# PostgreSQL 15+ (project target: 16). Local development database — see docker-compose.yml.
# The password below is a throwaway for the local container only; never reuse it anywhere else.
# Name rule: a database ending in "_test" is a TEST database and is refused unless NAZIR_RUNTIME_ENV=test.
DATABASE_URL=postgresql://nazir:nazir@localhost:5432/nazir_dev

# Optional. Direct (non-pooled) connection for the Prisma CLI (migrate) and the seed. Leave unset locally: they then use
# DATABASE_URL. On Neon: DATABASE_URL = the POOLED URL (host contains "-pooler"), DATABASE_URL_UNPOOLED = the DIRECT URL
# of the SAME database (the guard refuses a pair naming different databases). Never commit real values.
# DATABASE_URL_UNPOOLED=

# Server used by `npm run test:db`. The named database is never written to; the tests create and drop
# throwaway `nazir_ct_*_test` databases next to it. Must end in "_test" and be on localhost.
TEST_DATABASE_URL=postgresql://nazir:nazir@localhost:5432/nazir_test

# Only for `prisma migrate dev` / `migrate diff --from-migrations` (a scratch database that may be wiped).
# SHADOW_DATABASE_URL=postgresql://nazir:nazir@localhost:5432/nazir_shadow
