# Copy to .env.local for local development. Never commit real keys.
# Rules are enforced at server startup (src/server/config/runtime-config.ts).

# local | test | staging | production. Missing or unknown => production (fail-closed).
NAZIR_RUNTIME_ENV=local

# mock | toss   (mock allowed only in local/test)
PAYMENT_PROVIDER=mock
# mock | nice   (mock allowed only in local/test)
IDENTITY_PROVIDER=mock

# Toss Payments — API individual integration keys only (test_ck_/test_sk_; live_ only in production)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_SECURITY_KEY=

# NICE ID — issued after outbound IP registration
NICE_CLIENT_ID=
NICE_CLIENT_SECRET=
# Comma-separated client ids this environment may use (required in production)
NICE_ALLOWED_CLIENT_IDS=

# ── Browser binding / CSRF (Step 4, DECISIONS A-044) ──────────────────────────
# Exact origin of the site. Required in staging/production (startup refuses without it). local/test: no default either —
# without it /api/v1/bootstrap answers 500. http is accepted only for localhost/127.0.0.1 in local/test.
NAZIR_APP_ORIGIN=http://localhost:3000
# CSRF HMAC keyring: "v1:<base64url, >=32 bytes>[,v2:...]" + the version used for new tokens. Generate a key with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Never reuse this key for anything else (subject HMAC / encryption keys are separate keyrings).
NAZIR_CSRF_KEYS=
NAZIR_CSRF_KEY_CURRENT=

# ── Rate limit (Step 4, DECISIONS A-045) ──────────────────────────────────────
# Own HMAC keyring, never the CSRF key. Required in staging/production; local/test fail closed (503) without it.
NAZIR_RATE_LIMIT_KEYS=
NAZIR_RATE_LIMIT_KEY_CURRENT=
# vercel = trust only x-vercel-forwarded-for (required in staging/production). fixed = local/test only.
NAZIR_CLIENT_IP_SOURCE=fixed
NAZIR_CLIENT_IP_FIXED=127.0.0.1
# Optional overrides "<policy>=<limit>/<window seconds>,...". identity.start.* defaults are confirmed (A-047:
# ip 60/600, binding 5/600); order.* defaults are confirmed too (A-053: session 3/1800, subject_session 5/3600). Overriding a confirmed value is a policy change.
# NAZIR_RATE_LIMIT_POLICIES=order.create.session=3/1800

# ── Identity subject HMAC / personal-data encryption (Step 4, DECISIONS A-043) ──
# Separate keyrings; startup refuses any key shared with another keyring. Required in staging/production.
# Rotation: add the new version to EVERY instance first (current unchanged), then switch _KEY_CURRENT, and remove
# the old version only when no row uses it.
NAZIR_SUBJECT_HMAC_KEYS=
NAZIR_SUBJECT_HMAC_KEY_CURRENT=
# AES-256-GCM: each key must be exactly 32 bytes (base64url).
NAZIR_PII_ENC_KEYS=
NAZIR_PII_ENC_KEY_CURRENT=

# Provider transaction context (identity_verifications.provider_context_encrypted, A-049): its own AES-256 keyring.
NAZIR_PROVIDER_CTX_ENC_KEYS=
NAZIR_PROVIDER_CTX_ENC_KEY_CURRENT=

# ── Database (Step 2) ─────────────────────────────────────────────────────────
# PostgreSQL 15+ (project target: 16). Local development database — see docker-compose.yml.
# The password below is a throwaway for the local container only; never reuse it anywhere else.
# Name rule: a database ending in "_test" is a TEST database and is refused unless NAZIR_RUNTIME_ENV=test.
DATABASE_URL=postgresql://nazir:nazir@localhost:5432/nazir_dev

# Optional. Direct (non-pooled) connection for the Prisma CLI (migrate) and the seed. Leave unset locally: they then use
# DATABASE_URL. On Neon: DATABASE_URL = the POOLED URL (host contains "-pooler"), DATABASE_URL_UNPOOLED = the DIRECT URL
# of the SAME database (the guard refuses a pair naming different databases). Never commit real values.
# DATABASE_URL_UNPOOLED=

# Server used by `npm run test:db`. The named database is never written to; the tests create and drop
# throwaway `nazir_ct_*_test` databases next to it. Must end in "_test" and be on localhost.
TEST_DATABASE_URL=postgresql://nazir:nazir@localhost:5432/nazir_test

# Only for `prisma migrate dev` / `migrate diff --from-migrations` (a scratch database that may be wiped).
# SHADOW_DATABASE_URL=postgresql://nazir:nazir@localhost:5432/nazir_shadow

# ── Database pool and transaction limits (Step 5, review M8, DECISIONS A-053) ───────────────────────────────────────
# local/test: the development defaults below apply when unset. staging/production: EVERY value is required (the server
# refuses to start). Production numbers are NOT decided: size NAZIR_DB_POOL_MAX so that
# (max function instances × NAZIR_DB_POOL_MAX) stays below the Neon pooled-connection limit (E-007).
# Rules: LOCK < STATEMENT < TX_TIMEOUT, CONNECTION_TIMEOUT > TX_MAX_WAIT.
# NAZIR_DB_POOL_MAX=5
# NAZIR_DB_CONNECTION_TIMEOUT_MS=5000
# NAZIR_DB_IDLE_TIMEOUT_MS=10000
# NAZIR_DB_TX_MAX_WAIT_MS=2000
# NAZIR_DB_TX_TIMEOUT_MS=10000
# NAZIR_DB_STATEMENT_TIMEOUT_MS=5000
# NAZIR_DB_LOCK_TIMEOUT_MS=2000
